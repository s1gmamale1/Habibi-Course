# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# session scratch (not for git)
.superpowers/
.claude-flow/
.swarm/
.claude/settings.local.json
ruvector.db
*.db-journal

# Ruflo's vector store, written to whatever directory it is started in.
agentdb.rvf
agentdb.rvf.lock

# Scan reports are regenerable output, and `npm run security:scan` drops them
# next to whatever it scanned — scanning ./src writes src/.claude/security-scans/.
# The leading `**/` is what keeps that copy out of the source tree.
**/.claude/security-scans/

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# Codex local configuration
.codex/
# Claude Flow runtime data
# Environment variables

# Obsidian per-machine UI state (the vault itself IS committed)
library/.obsidian/workspace*.json
library/.obsidian/cache
