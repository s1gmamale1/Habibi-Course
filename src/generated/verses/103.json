[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ","spans":[{"start":41,"end":42,"rules":["hamzat_wasl"]}]},{"ayah":2,"text":"إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ","spans":[{"start":2,"end":5,"rules":["ghunnah"]},{"start":6,"end":7,"rules":["hamzat_wasl"]},{"start":11,"end":12,"rules":["ikhfa"]},{"start":12,"end":15,"rules":["ikhfa","madd_2"]}]},{"ayah":3,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","spans":[{"start":7,"end":8,"rules":["hamzat_wasl"]},{"start":25,"end":27,"rules":["silent"]},{"start":37,"end":39,"rules":["silent"]},{"start":40,"end":41,"rules":["hamzat_wasl"]},{"start":41,"end":42,"rules":["lam_shamsiyyah"]},{"start":42,"end":46,"rules":["madd_2"]},{"start":48,"end":51,"rules":["madd_2"]},{"start":65,"end":67,"rules":["silent"]},{"start":70,"end":71,"rules":["hamzat_wasl"]},{"start":90,"end":92,"rules":["silent"]},{"start":95,"end":96,"rules":["hamzat_wasl"]},{"start":96,"end":97,"rules":["lam_shamsiyyah"]},{"start":100,"end":102,"rules":["qalqalah"]}]}]