[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","spans":[{"start":79,"end":82,"rules":["madd_2"]},{"start":85,"end":86,"rules":["hamzat_wasl"]},{"start":90,"end":91,"rules":["madd_246"]}]},{"ayah":2,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ","spans":[{"start":9,"end":11,"rules":["qalqalah"]},{"start":37,"end":38,"rules":["madd_246"]}]},{"ayah":3,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","spans":[{"start":37,"end":38,"rules":["madd_246"]}]},{"ayah":4,"text":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","spans":[{"start":9,"end":13,"rules":["ikhfa_shafawi"]},{"start":20,"end":26,"rules":["idghaam_ghunnah"]},{"start":26,"end":30,"rules":["ikhfa"]},{"start":33,"end":34,"rules":["madd_246"]}]},{"ayah":5,"text":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ","spans":[{"start":19,"end":25,"rules":["idghaam_ghunnah"]},{"start":29,"end":30,"rules":["madd_246"]}]}]