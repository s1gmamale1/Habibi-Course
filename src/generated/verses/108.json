[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","spans":[{"start":41,"end":44,"rules":["ghunnah"]},{"start":44,"end":46,"rules":["madd_munfasil"]},{"start":57,"end":59,"rules":["madd_2"]},{"start":61,"end":63,"rules":["hamzat_wasl"]}]},{"ayah":2,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","spans":[{"start":20,"end":21,"rules":["hamzat_wasl"]}]},{"ayah":3,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","spans":[{"start":2,"end":5,"rules":["ghunnah"]},{"start":21,"end":22,"rules":["hamzat_wasl"]},{"start":26,"end":28,"rules":["qalqalah"]}]}]