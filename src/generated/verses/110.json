[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ","spans":[{"start":47,"end":50,"rules":["madd_muttasil"]},{"start":59,"end":60,"rules":["hamzat_wasl"]},{"start":69,"end":71,"rules":["hamzat_wasl"]}]},{"ayah":2,"text":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا","spans":[{"start":11,"end":12,"rules":["hamzat_wasl"]},{"start":12,"end":13,"rules":["lam_shamsiyyah"]},{"start":13,"end":16,"rules":["ghunnah"]},{"start":22,"end":24,"rules":["qalqalah"]},{"start":42,"end":43,"rules":["hamzat_wasl"]}]},{"ayah":3,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ إِنَّهُۥ كَانَ تَوَّابًۢا","spans":[{"start":29,"end":30,"rules":["hamzat_wasl"]},{"start":45,"end":48,"rules":["ghunnah"]},{"start":50,"end":51,"rules":["madd_2"]}]}]