[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","spans":[{"start":49,"end":50,"rules":["hamzat_wasl"]},{"start":61,"end":63,"rules":["qalqalah"]}]},{"ayah":2,"text":"ٱللَّهُ ٱلصَّمَدُ","spans":[{"start":8,"end":9,"rules":["hamzat_wasl"]},{"start":9,"end":10,"rules":["lam_shamsiyyah"]},{"start":15,"end":17,"rules":["qalqalah"]}]},{"ayah":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","spans":[{"start":9,"end":11,"rules":["qalqalah"]},{"start":24,"end":26,"rules":["qalqalah"]}]},{"ayah":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","spans":[{"start":11,"end":16,"rules":["idghaam_no_ghunnah"]},{"start":18,"end":19,"rules":["madd_2"]},{"start":32,"end":35,"rules":["qalqalah"]}]}]