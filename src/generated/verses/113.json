[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","spans":[{"start":60,"end":61,"rules":["hamzat_wasl"]},{"start":67,"end":69,"rules":["qalqalah"]}]},{"ayah":2,"text":"مِن شَرِّ مَا خَلَقَ","spans":[{"start":2,"end":6,"rules":["ikhfa"]},{"start":18,"end":20,"rules":["qalqalah"]}]},{"ayah":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","spans":[{"start":4,"end":8,"rules":["ikhfa"]},{"start":30,"end":32,"rules":["qalqalah"]}]},{"ayah":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","spans":[{"start":4,"end":8,"rules":["ikhfa"]},{"start":12,"end":13,"rules":["hamzat_wasl"]},{"start":13,"end":14,"rules":["lam_shamsiyyah"]},{"start":14,"end":17,"rules":["ghunnah"]},{"start":17,"end":21,"rules":["madd_2"]},{"start":21,"end":24,"rules":["madd_2"]},{"start":31,"end":32,"rules":["hamzat_wasl"]},{"start":38,"end":40,"rules":["qalqalah"]}]},{"ayah":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","spans":[{"start":4,"end":8,"rules":["ikhfa"]},{"start":30,"end":32,"rules":["qalqalah"]}]}]