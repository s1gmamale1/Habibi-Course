[{"ayah":4,"text":"وَفِى ٱلْأَرْضِ قِطَعٌ مُّتَجَٰوِرَٰتٌ وَجَنَّٰتٌ مِّنْ أَعْنَٰبٍ وَزَرْعٌ وَنَخِيلٌ صِنْوَانٌ وَغَيْرُ صِنْوَانٍ يُسْقَىٰ بِمَآءٍ وَٰحِدٍ وَنُفَضِّلُ بَعْضَهَا عَلَىٰ بَعْضٍ فِى ٱلْأُكُلِ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يَعْقِلُونَ","spans":[{"start":6,"end":7,"rules":["hamzat_wasl"]},{"start":20,"end":26,"rules":["idghaam_ghunnah"]},{"start":28,"end":31,"rules":["madd_2"]},{"start":33,"end":36,"rules":["madd_2"]},{"start":36,"end":41,"rules":["idghaam_ghunnah"]},{"start":43,"end":47,"rules":["ghunnah","madd_2"]},{"start":47,"end":53,"rules":["idghaam_ghunnah"]},{"start":60,"end":63,"rules":["madd_2"]},{"start":63,"end":68,"rules":["idghaam_ghunnah"]},{"start":72,"end":77,"rules":["idghaam_ghunnah"]},{"start":82,"end":87,"rules":["ikhfa"]},{"start":92,"end":97,"rules":["idghaam_ghunnah"]},{"start":111,"end":116,"rules":["idghaam_ghunnah"]},{"start":127,"end":130,"rules":["madd_muttasil"]},{"start":130,"end":134,"rules":["idghaam_ghunnah"]},{"start":134,"end":136,"rules":["madd_2"]},{"start":138,"end":143,"rules":["idghaam_ghunnah"]},{"start":174,"end":178,"rules":["ikhfa"]},{"start":180,"end":182,"rules":["hamzat_wasl"]},{"start":191,"end":195,"rules":["ghunnah"]},{"start":202,"end":204,"rules":["madd_2"]},{"start":215,"end":217,"rules":["madd_2"]},{"start":217,"end":223,"rules":["idghaam_no_ghunnah"]},{"start":227,"end":232,"rules":["idghaam_ghunnah"]},{"start":237,"end":239,"rules":["madd_246"]}]}]