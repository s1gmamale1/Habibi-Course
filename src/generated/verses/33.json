[{"ayah":10,"text":"إِذْ جَآءُوكُم مِّن فَوْقِكُمْ وَمِنْ أَسْفَلَ مِنكُمْ وَإِذْ زَاغَتِ ٱلْأَبْصَٰرُ وَبَلَغَتِ ٱلْقُلُوبُ ٱلْحَنَاجِرَ وَتَظُنُّونَ بِٱللَّهِ ٱلظُّنُونَا۠","spans":[{"start":7,"end":10,"rules":["madd_muttasil"]},{"start":14,"end":19,"rules":["idghaam_shafawi"]},{"start":19,"end":24,"rules":["ikhfa"]},{"start":50,"end":54,"rules":["ikhfa"]},{"start":71,"end":73,"rules":["hamzat_wasl"]},{"start":75,"end":80,"rules":["qalqalah"]},{"start":80,"end":82,"rules":["madd_2"]},{"start":95,"end":97,"rules":["hamzat_wasl"]},{"start":106,"end":108,"rules":["hamzat_wasl"]},{"start":124,"end":128,"rules":["ghunnah"]},{"start":134,"end":135,"rules":["hamzat_wasl"]},{"start":142,"end":143,"rules":["hamzat_wasl"]},{"start":143,"end":146,"rules":["lam_shamsiyyah"]}]}]