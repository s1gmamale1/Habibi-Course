[{"ayah":12,"text":"وَلِسُلَيْمَٰنَ ٱلرِّيحَ غُدُوُّهَا شَهْرٌ وَرَوَاحُهَا شَهْرٌ وَأَسَلْنَا لَهُۥ عَيْنَ ٱلْقِطْرِ وَمِنَ ٱلْجِنِّ مَن يَعْمَلُ بَيْنَ يَدَيْهِ بِإِذْنِ رَبِّهِۦ وَمَن يَزِغْ مِنْهُمْ عَنْ أَمْرِنَا نُذِقْهُ مِنْ عَذَابِ ٱلسَّعِيرِ","spans":[{"start":10,"end":13,"rules":["madd_2"]},{"start":16,"end":17,"rules":["hamzat_wasl"]},{"start":17,"end":18,"rules":["lam_shamsiyyah"]},{"start":40,"end":45,"rules":["idghaam_ghunnah"]},{"start":60,"end":65,"rules":["idghaam_ghunnah"]},{"start":79,"end":80,"rules":["madd_2"]},{"start":88,"end":89,"rules":["hamzat_wasl"]},{"start":93,"end":95,"rules":["qalqalah"]},{"start":105,"end":106,"rules":["hamzat_wasl"]},{"start":110,"end":113,"rules":["ghunnah"]},{"start":116,"end":120,"rules":["idghaam_ghunnah"]},{"start":159,"end":160,"rules":["madd_2"]},{"start":165,"end":169,"rules":["idghaam_ghunnah"]},{"start":202,"end":204,"rules":["qalqalah"]},{"start":220,"end":221,"rules":["hamzat_wasl"]},{"start":221,"end":222,"rules":["lam_shamsiyyah"]},{"start":227,"end":228,"rules":["madd_246"]}]}]