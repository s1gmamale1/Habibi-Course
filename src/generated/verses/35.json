[{"ayah":43,"text":"ٱسْتِكْبَارًا فِى ٱلْأَرْضِ وَمَكْرَ ٱلسَّيِّئِ وَلَا يَحِيقُ ٱلْمَكْرُ ٱلسَّيِّئُ إِلَّا بِأَهْلِهِۦ فَهَلْ يَنظُرُونَ إِلَّا سُنَّتَ ٱلْأَوَّلِينَ فَلَن تَجِدَ لِسُنَّتِ ٱللَّهِ تَبْدِيلًا وَلَن تَجِدَ لِسُنَّتِ ٱللَّهِ تَحْوِيلًا","spans":[{"start":10,"end":16,"rules":["ikhfa"]},{"start":18,"end":19,"rules":["hamzat_wasl"]},{"start":37,"end":38,"rules":["hamzat_wasl"]},{"start":38,"end":39,"rules":["lam_shamsiyyah"]},{"start":62,"end":63,"rules":["hamzat_wasl"]},{"start":72,"end":73,"rules":["hamzat_wasl"]},{"start":73,"end":74,"rules":["lam_shamsiyyah"]},{"start":100,"end":101,"rules":["madd_2"]},{"start":111,"end":114,"rules":["ikhfa"]},{"start":129,"end":132,"rules":["ghunnah"]},{"start":135,"end":136,"rules":["hamzat_wasl"]},{"start":153,"end":157,"rules":["ikhfa"]},{"start":166,"end":169,"rules":["ghunnah"]},{"start":172,"end":173,"rules":["hamzat_wasl"]},{"start":182,"end":184,"rules":["qalqalah"]},{"start":187,"end":193,"rules":["idghaam_ghunnah"]},{"start":195,"end":199,"rules":["ikhfa"]},{"start":208,"end":211,"rules":["ghunnah"]},{"start":214,"end":215,"rules":["hamzat_wasl"]}]}]