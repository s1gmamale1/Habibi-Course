[{"ayah":7,"text":"إِن تَكْفُرُوا۟ فَإِنَّ ٱللَّهَ غَنِىٌّ عَنكُمْ وَلَا يَرْضَىٰ لِعِبَادِهِ ٱلْكُفْرَ وَإِن تَشْكُرُوا۟ يَرْضَهُ لَكُمْ وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ ثُمَّ إِلَىٰ رَبِّكُم مَّرْجِعُكُمْ فَيُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ إِنَّهُۥ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ","spans":[{"start":2,"end":6,"rules":["ikhfa"]},{"start":13,"end":15,"rules":["silent"]},{"start":20,"end":23,"rules":["ghunnah"]},{"start":24,"end":25,"rules":["hamzat_wasl"]},{"start":42,"end":45,"rules":["ikhfa"]},{"start":75,"end":76,"rules":["hamzat_wasl"]},{"start":89,"end":93,"rules":["ikhfa"]},{"start":100,"end":102,"rules":["silent"]},{"start":139,"end":144,"rules":["idghaam_ghunnah"]},{"start":160,"end":163,"rules":["ghunnah"]},{"start":178,"end":183,"rules":["idghaam_shafawi"]},{"start":207,"end":211,"rules":["ikhfa_shafawi"]},{"start":217,"end":220,"rules":["ikhfa"]},{"start":237,"end":240,"rules":["ghunnah"]},{"start":242,"end":243,"rules":["madd_2"]},{"start":249,"end":255,"rules":["iqlab"]},{"start":261,"end":262,"rules":["hamzat_wasl"]},{"start":262,"end":263,"rules":["lam_shamsiyyah"]},{"start":268,"end":269,"rules":["madd_246"]}]}]