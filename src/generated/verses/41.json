[{"ayah":44,"text":"وَلَوْ جَعَلْنَٰهُ قُرْءَانًا أَعْجَمِيًّا لَّقَالُوا۟ لَوْلَا فُصِّلَتْ ءَايَٰتُهُۥٓ ءَا۬عْجَمِىٌّ وَعَرَبِىٌّ قُلْ هُوَ لِلَّذِينَ ءَامَنُوا۟ هُدًى وَشِفَآءٌ وَٱلَّذِينَ لَا يُؤْمِنُونَ فِىٓ ءَاذَانِهِمْ وَقْرٌ وَهُوَ عَلَيْهِمْ عَمًى أُو۟لَٰٓئِكَ يُنَادَوْنَ مِن مَّكَانٍۭ بَعِيدٍ","spans":[{"start":13,"end":16,"rules":["madd_2"]},{"start":38,"end":46,"rules":["idghaam_no_ghunnah"]},{"start":52,"end":54,"rules":["silent"]},{"start":76,"end":79,"rules":["madd_2"]},{"start":83,"end":85,"rules":["madd_munfasil"]},{"start":96,"end":102,"rules":["idghaam_ghunnah"]},{"start":108,"end":114,"rules":["ikhfa"]},{"start":141,"end":143,"rules":["silent"]},{"start":146,"end":152,"rules":["idghaam_ghunnah"]},{"start":156,"end":159,"rules":["madd_muttasil"]},{"start":159,"end":163,"rules":["idghaam_ghunnah"]},{"start":163,"end":166,"rules":["hamzat_wasl"]},{"start":190,"end":193,"rules":["madd_munfasil"]},{"start":208,"end":212,"rules":["qalqalah"]},{"start":212,"end":217,"rules":["idghaam_ghunnah"]},{"start":239,"end":241,"rules":["silent"]},{"start":241,"end":245,"rules":["silent","madd_muttasil"]},{"start":245,"end":247,"rules":["madd_muttasil"]},{"start":265,"end":271,"rules":["idghaam_ghunnah"]},{"start":272,"end":278,"rules":["iqlab"]},{"start":281,"end":283,"rules":["madd_246","qalqalah"]}]}]