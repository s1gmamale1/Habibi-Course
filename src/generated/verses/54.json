[{"ayah":10,"text":"فَدَعَا رَبَّهُۥٓ أَنِّى مَغْلُوبٌ فَٱنتَصِرْ","spans":[{"start":15,"end":17,"rules":["madd_munfasil"]},{"start":20,"end":23,"rules":["ghunnah"]},{"start":32,"end":37,"rules":["ikhfa"]},{"start":37,"end":38,"rules":["hamzat_wasl"]},{"start":38,"end":41,"rules":["ikhfa"]}]},{"ayah":16,"text":"فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ","spans":[]},{"ayah":42,"text":"كَذَّبُوا۟ بِـَٔايَٰتِنَا كُلِّهَا فَأَخَذْنَٰهُمْ أَخْذَ عَزِيزٍ مُّقْتَدِرٍ","spans":[{"start":8,"end":10,"rules":["silent"]},{"start":17,"end":20,"rules":["madd_2"]},{"start":43,"end":46,"rules":["madd_2"]},{"start":63,"end":69,"rules":["idghaam_ghunnah"]},{"start":69,"end":71,"rules":["qalqalah"]}]}]