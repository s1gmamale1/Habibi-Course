[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ","spans":[{"start":44,"end":48,"rules":["madd_6"]}]},{"ayah":28,"text":"مَآ أَغْنَىٰ عَنِّى مَالِيَهْ","spans":[{"start":2,"end":4,"rules":["madd_munfasil"]},{"start":15,"end":19,"rules":["ghunnah"]}]},{"ayah":29,"text":"هَلَكَ عَنِّى سُلْطَٰنِيَهْ","spans":[{"start":9,"end":12,"rules":["ghunnah"]},{"start":18,"end":21,"rules":["madd_2"]}]}]