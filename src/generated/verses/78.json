[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ","spans":[{"start":41,"end":44,"rules":["ghunnah"]},{"start":51,"end":54,"rules":["madd_muttasil"]},{"start":57,"end":59,"rules":["madd_246"]}]},{"ayah":14,"text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا","spans":[{"start":4,"end":7,"rules":["ikhfa"]},{"start":18,"end":19,"rules":["hamzat_wasl"]},{"start":27,"end":30,"rules":["madd_2"]},{"start":35,"end":38,"rules":["madd_muttasil"]},{"start":38,"end":44,"rules":["ikhfa"]}]},{"ayah":21,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","spans":[{"start":2,"end":5,"rules":["ghunnah"]},{"start":10,"end":13,"rules":["ghunnah"]}]}]