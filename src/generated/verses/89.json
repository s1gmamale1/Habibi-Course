[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ","spans":[{"start":41,"end":42,"rules":["hamzat_wasl"]},{"start":46,"end":48,"rules":["qalqalah"]}]},{"ayah":3,"text":"وَٱلشَّفْعِ وَٱلْوَتْرِ","spans":[{"start":2,"end":3,"rules":["hamzat_wasl"]},{"start":3,"end":4,"rules":["lam_shamsiyyah"]},{"start":14,"end":15,"rules":["hamzat_wasl"]}]},{"ayah":4,"text":"وَٱلَّيْلِ إِذَا يَسْرِ","spans":[{"start":2,"end":3,"rules":["hamzat_wasl"]}]},{"ayah":10,"text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ","spans":[{"start":17,"end":18,"rules":["hamzat_wasl"]},{"start":26,"end":27,"rules":["madd_246"]},{"start":27,"end":29,"rules":["qalqalah"]}]},{"ayah":14,"text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","spans":[{"start":2,"end":5,"rules":["ghunnah"]},{"start":18,"end":19,"rules":["hamzat_wasl"]},{"start":27,"end":28,"rules":["madd_246"]},{"start":28,"end":30,"rules":["qalqalah"]}]},{"ayah":16,"text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ","spans":[{"start":4,"end":7,"rules":["ghunnah"]},{"start":7,"end":9,"rules":["madd_munfasil"]},{"start":20,"end":22,"rules":["hamzat_wasl","qalqalah"]},{"start":22,"end":24,"rules":["qalqalah"]},{"start":28,"end":30,"rules":["madd_2"]},{"start":58,"end":59,"rules":["madd_2"]},{"start":74,"end":77,"rules":["madd_munfasil"]},{"start":82,"end":84,"rules":["madd_2"]}]},{"ayah":28,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً","spans":[{"start":7,"end":9,"rules":["madd_munfasil"]},{"start":32,"end":38,"rules":["idghaam_ghunnah"]}]}]