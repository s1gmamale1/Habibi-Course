[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","spans":[{"start":62,"end":64,"rules":["qalqalah"]}]},{"ayah":3,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","spans":[{"start":6,"end":8,"rules":["madd_munfasil"]},{"start":11,"end":14,"rules":["ikhfa"]}]},{"ayah":5,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","spans":[{"start":4,"end":7,"rules":["ghunnah"]},{"start":13,"end":14,"rules":["hamzat_wasl"]}]}]