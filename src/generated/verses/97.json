[{"ayah":1,"text":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ","spans":[{"start":42,"end":45,"rules":["ghunnah"]},{"start":45,"end":47,"rules":["madd_munfasil"]},{"start":50,"end":54,"rules":["ikhfa"]},{"start":57,"end":59,"rules":["madd_2"]},{"start":74,"end":76,"rules":["hamzat_wasl"]},{"start":78,"end":82,"rules":["qalqalah"]}]},{"ayah":3,"text":"لَيْلَةُ ٱلْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ","spans":[{"start":9,"end":10,"rules":["hamzat_wasl"]},{"start":14,"end":16,"rules":["qalqalah"]},{"start":23,"end":29,"rules":["idghaam_ghunnah"]}]},{"ayah":4,"text":"تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ","spans":[{"start":10,"end":11,"rules":["hamzat_wasl"]},{"start":15,"end":19,"rules":["madd_muttasil"]},{"start":28,"end":29,"rules":["hamzat_wasl"]},{"start":29,"end":30,"rules":["lam_shamsiyyah"]},{"start":60,"end":65,"rules":["idghaam_shafawi"]},{"start":65,"end":69,"rules":["ikhfa"]}]},{"ayah":5,"text":"سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ","spans":[{"start":2,"end":5,"rules":["madd_2"]},{"start":23,"end":25,"rules":["qalqalah"]},{"start":30,"end":31,"rules":["hamzat_wasl"]},{"start":35,"end":37,"rules":["qalqalah"]}]}]